<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<BorderPane style="-fx-background-color: white;" stylesheets="@/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rm.view.ProductDetailController">
    <top>
        <VBox spacing="10">
            <padding>
                <Insets bottom="10" left="20" right="20" top="20" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label fx:id="lblBack" onMouseClicked="#goBack" style="-fx-text-fill: #888; -fx-cursor: hand;" text="← Menu" />
                <Label fx:id="lblName" style="-fx-font-size: 26px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnEdit" onAction="#onEdit" styleClass="icon-button" stylesheets="@style.css">
                    <graphic>
                        <FontIcon iconLiteral="fas-edit" iconSize="18" styleClass="icon-container" />
                    </graphic>
                </Button>
                <Button fx:id="btnDelete" onAction="#onDelete" styleClass="icon-button" stylesheets="@style.css">
                    <graphic>
                        <FontIcon iconLiteral="fas-trash" iconSize="18" />
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox fx:id="contentBox" spacing="25">
            <padding>
                <Insets bottom="20" left="20" right="20" top="30" />
            </padding>
        </VBox>
    </center>
</BorderPane>
