<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="view-background"
            stylesheets="@/style.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.rm.view.OrderController">

    <top>
        <VBox spacing="10" stylesheets="@style.css">
            <padding>
                <Insets bottom="10" left="20" right="20" top="20"/>
            </padding>

            <Label fx:id="lblManage" onMouseClicked="#goBack"
                   styleClass="link-label" text="← Manage"/>

            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label styleClass="text-header" text="Ordini"/>
                <Region HBox.hgrow="ALWAYS"/>

                <TextField fx:id="txtSearch"
                           prefWidth="250"
                           promptText="Cerca per tavolo o utente"
                           style="-fx-font-size: 13px;"
                           styleClass="input-standard"
                           stylesheets="@style.css"/>
            </HBox>

            <HBox spacing="10">
                <Button fx:id="btnRefresh" text="Aggiorna" onAction="#onRefresh"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnReady" text="Segna READY" onAction="#onMarkReady"/>
                <Button fx:id="btnClose" text="Chiudi" onAction="#onCloseOrder"/>
                <Button fx:id="btnCancel" text="Annulla" onAction="#onCancelOrder"/>
            </HBox>

            <Separator/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblOrders" columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
            <columns>
                <TableColumn fx:id="colId" text="ID"/>
                <TableColumn fx:id="colDate" text="Data/Ora"/>
                <TableColumn fx:id="colTable" text="Tavolo"/>
                <TableColumn fx:id="colUser" text="Utente"/>
                <TableColumn fx:id="colStatus" text="Stato"/>
                <TableColumn fx:id="colTotal" text="Totale"/>
                <TableColumn fx:id="colNote" text="Note"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
