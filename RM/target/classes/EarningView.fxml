<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rm.view.EarningController">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets bottom="5" left="20" right="20" top="10" />
                </padding>
                <StackPane fx:id="profileBtn" onMouseClicked="#handleProfileMenu" style="-fx-cursor: hand;">
                    <Circle fx:id="profileCircle" fill="LIGHTGRAY" radius="16" styleClass="surface-card" />
                </StackPane>
                <VBox>
                    <Label fx:id="lblHeaderName" style="-fx-font-weight: bold;" />
                    <Label fx:id="lblHeaderRole" style="-fx-font-size: 11px;" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets bottom="15" left="20" right="20" top="15" />
                </padding>
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" styleClass="text-header" text="Cash Desk" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" onKeyReleased="#onSearch" promptText="Search table..." styleClass="input-standard" />
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.6">
            <VBox spacing="10">
                <ScrollPane fitToWidth="true" stylesheets="@style.css" VBox.vgrow="ALWAYS">
                    <VBox fx:id="ordersContainer" spacing="5">
                        <padding>
                            <Insets bottom="15" left="15" right="15" top="15" />
                        </padding>
                    </VBox>
                </ScrollPane>
            </VBox>

            <VBox fx:id="detailsPane" spacing="15" style="-fx-background-color: #F9F9F9;">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>
                <Label fx:id="lblPlaceholder" styleClass="text-title" text="Select an order" />
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
