<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:controller="com.example.rm.view.component.ChangePasswordDialogController"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      spacing="20"
      alignment="TOP_CENTER"
      stylesheets="/style.css"
      styleClass="cp-root">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <!-- Titolo -->
    <Label fx:id="lblTitle" text="Cambio Password" styleClass="cp-title"/>

    <Label fx:id="lblSubtitle"
           text="Inserisci la tua password corrente e la nuova password"
           styleClass="cp-subtitle"/>

    <!-- Box utente -->
    <VBox fx:id="userBox" spacing="5" styleClass="cp-user-box">
        <Label fx:id="lblUsernameLabel" text="Utente:" styleClass="cp-user-label"/>
        <Label fx:id="lblUsername" text="username" styleClass="cp-username"/>
    </VBox>

    <!-- Campi password -->
    <VBox fx:id="fieldsBox" spacing="15">
        <Label text="Password Corrente:" styleClass="cp-field-label"/>
        <PasswordField fx:id="txtCurrentPassword" promptText="Inserisci password attuale" styleClass="cp-password-field"/>

        <Label text="Nuova Password:" styleClass="cp-field-label"/>
        <PasswordField fx:id="txtNewPassword"
                       promptText="Minimo 6 caratteri"
                       styleClass="cp-password-field"/>

        <Label text="Conferma Nuova Password:" styleClass="cp-field-label"/>
        <PasswordField fx:id="txtConfirmPassword"
                       promptText="Reinserisci nuova password"
                       styleClass="cp-password-field"/>
    </VBox>

    <!-- Requisiti -->
    <Label fx:id="lblRequirements"
           text="• Minimo 6 caratteri&#10;• Usa lettere, numeri e simboli per maggiore sicurezza"
           styleClass="cp-requirements"/>

    <!-- Feedback -->
    <Label fx:id="lblFeedback" visible="false" wrapText="true" maxWidth="300"
           styleClass="cp-feedback"/>

    <!-- Pulsanti -->
    <HBox fx:id="buttonsBox" spacing="10" alignment="CENTER">
        <Button fx:id="btnCancel" text="Annulla" styleClass="cp-btn-cancel"/>
        <Button fx:id="btnSave" text="Salva" styleClass="cp-btn-save"/>
    </HBox>

</VBox>
