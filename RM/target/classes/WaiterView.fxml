<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="root" styleClass="waiter-root" stylesheets="@/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rm.view.WaiterController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="waiter-header" stylesheets="@style.css">
            <StackPane fx:id="profileBtn" onMouseClicked="#handleProfileMenu" styleClass="profile-stack" stylesheets="@style.css">
                <Circle fx:id="profileCircle" radius="25" styleClass="profile-circle" />
            </StackPane>

            <VBox spacing="2">
                <Label fx:id="lblHeaderName" styleClass="header-name" text="..." />
                <Label fx:id="lblHeaderRole" styleClass="header-role" text="..." />
            </VBox>

            <Label fx:id="lblWelcomeTop" styleClass="waiter-welcome-msg" text="..." />

            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" styleClass="waiter-scroll">
                <content>
                    <VBox fx:id="notificationsContainer" alignment="TOP_CENTER" spacing="15" styleClass="waiter-notifications">
                        <padding>
                            <Insets bottom="20" left="20" right="20" top="20" />
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </StackPane>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="10" styleClass="waiter-bottom-bar">
            <padding><Insets bottom="10" top="20" /></padding>

            <Button fx:id="btnNewOrder" onAction="#handleNewOrder" styleClass="btn-new-order" text="new&#10;order" textAlignment="CENTER" />

            <Label styleClass="waiter-table-label" text="table" />

            <TextField fx:id="txtTable" alignment="CENTER" promptText="number" styleClass="waiter-table-input" />
        </VBox>
    </bottom>

</BorderPane>
