<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane styleClass="view-background" stylesheets="@/styleBN.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rm.view.KitchenController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <top>
        <Label fx:id="lblActiveFilters" style="-fx-font-size: 12px; -fx-text-fill: #e8e8e8; -fx-padding: 10;" text="Filtri attivi: " />


        <HBox alignment="CENTER_LEFT" spacing="15">
            <padding><Insets bottom="20" /></padding>

            <StackPane fx:id="profileBtn" onMouseClicked="#handleProfileMenu" style="-fx-cursor: hand;">
                <Circle fx:id="profileCircle" fill="#cacbca" radius="25" stroke="#202020" strokeWidth="0" />
            </StackPane>

            <VBox spacing="2">
                <Label fx:id="lblHeaderName" style="-fx-font-size: 16px;" styleClass="text-title" text="..." />
                <Label fx:id="lblHeaderRole" style="-fx-font-size: 14px;" styleClass="text-body" text="Cucina" />
            </VBox>

            <Label fx:id="lblWelcomeMsg" style="-fx-text-fill: #c1c1c1; -fx-padding: 0 0 0 20; -fx-font-style: italic;" text="..." />

            <Region HBox.hgrow="ALWAYS" />

            <StackPane onMouseClicked="#refreshData" style="-fx-cursor: hand;" />

        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox fx:id="ordersContainer" spacing="10" style="-fx-background-color: trasparent">
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
