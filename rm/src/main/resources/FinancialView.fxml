<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="view-background" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rm.view.FinancialController">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets bottom="10" left="20" right="20" top="20" />
            </padding>

            <Label fx:id="lblManage" onMouseClicked="#goBack" styleClass="text-link" text="← Manage" />

            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label styleClass="text-header" text="Financial Overview" />
            </HBox>

            <TextField fx:id="txtSearch" prefWidth="300" promptText="Search by ID, table, date, total..." styleClass="input-standard" />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox fx:id="ordersContainer" spacing="0" styleClass="orders-container">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10" />
                </padding>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
