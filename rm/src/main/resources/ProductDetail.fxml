<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="view-background" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rm.view.ProductDetailController">

    <padding>
        <Insets bottom="30" left="40" right="40" top="30" />
    </padding>

    <top>
        <HBox alignment="TOP_LEFT" spacing="20">

            <VBox alignment="CENTER_LEFT" spacing="5">
                <Label fx:id="lblBack" styleClass="text-link" stylesheets="@style.css" text="← Menu" />

                <Label fx:id="lblName" styleClass="text-header" text="Product Name" wrapText="true" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="TOP_RIGHT" spacing="10">
                <Button fx:id="btnEdit" styleClass="btn-save" text="Edit" />

                <Button fx:id="btnDelete" style="-fx-text-fill: RED;" styleClass="btn-primary" text="Delete" />
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">

            <content>
                <VBox fx:id="contentBox" spacing="0" styleClass="orders-container" stylesheets="@style.css">
                    <padding>
                        <Insets top="30" />
                    </padding>
                </VBox>
            </content>

            <BorderPane.margin>
                <Insets top="20" />
            </BorderPane.margin>

        </ScrollPane>
    </center>

</BorderPane>
