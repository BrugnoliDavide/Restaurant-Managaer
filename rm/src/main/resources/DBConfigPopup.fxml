<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.rm.view.component.DBConfigPopupController">

    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

    <Label styleClass="text-title" text="Configurazione Database" style="-fx-font-size: 18px;" />

    <!-- ======================== -->
    <!-- TOGGLE MODALITÀ          -->
    <!-- ======================== -->
    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 5 0 5 0;">
        <fx:define>
            <ToggleGroup fx:id="modeToggle" />
        </fx:define>

        <RadioButton fx:id="radioParams" text="Parametri separati"
                     toggleGroup="$modeToggle" selected="true"
                     style="-fx-font-size: 12px;" />

        <RadioButton fx:id="radioUrl" text="URL diretto (JDBC)"
                     toggleGroup="$modeToggle"
                     style="-fx-font-size: 12px;" />
    </HBox>

    <Separator />

    <!-- ======================== -->
    <!-- MODALITÀ PARAMETRI       -->
    <!-- ======================== -->
    <VBox fx:id="paramFieldsBox" spacing="8">
        <TextField fx:id="addressField" promptText="Indirizzo (es. localhost, 192.168.1.100)"
                   styleClass="input-standard" />

        <TextField fx:id="portField" promptText="Porta (es. 5432)"
                   styleClass="input-standard" />

        <TextField fx:id="dbNameField" promptText="Nome database"
                   styleClass="input-standard" />

        <TextField fx:id="usernameField" promptText="Username"
                   styleClass="input-standard" />

        <PasswordField fx:id="passwordField" promptText="Password (vuoto = mantieni attuale)"
                       styleClass="input-standard" />
    </VBox>

    <!-- ======================== -->
    <!-- MODALITÀ URL DIRETTO     -->
    <!-- ======================== -->
    <VBox fx:id="urlFieldsBox" spacing="8" visible="false" managed="false">
        <Label text="URL JDBC:" style="-fx-font-size: 12px; -fx-text-fill: #555;" />

        <TextArea fx:id="urlField"
                  promptText="jdbc:postgresql://host:porta/database"
                  prefRowCount="2"
                  wrapText="true"
                  style="-fx-font-family: monospace; -fx-font-size: 12px;
                         -fx-border-color: #CCC; -fx-border-radius: 6px;
                         -fx-background-radius: 6px;" />

        <Label text="Formati accettati: jdbc:postgresql://host:porta/db  |  postgresql://host:porta/db  |  host:porta/db"
               style="-fx-font-size: 10px; -fx-text-fill: #888; -fx-wrap-text: true;" wrapText="true" />

        <TextField fx:id="urlUsernameField" promptText="Username"
                   styleClass="input-standard" />

        <PasswordField fx:id="urlPasswordField" promptText="Password"
                       styleClass="input-standard" />
    </VBox>

    <Separator />

    <!-- ======================== -->
    <!-- OPZIONI                  -->
    <!-- ======================== -->
    <CheckBox fx:id="demoModeCheckBox" text="Modalità DEMO (dati non persistenti)"
              style="-fx-font-size: 11px;" />

    <CheckBox fx:id="chkEink" text="Grafica semplificata B&amp;N"
              style="-fx-font-size: 11px;" />

    <!-- ======================== -->
    <!-- FEEDBACK                 -->
    <!-- ======================== -->
    <Label fx:id="lblStatus" text="" wrapText="true" visible="false"
           style="-fx-font-size: 12px; -fx-padding: 5 0 0 0;"
           maxWidth="Infinity" />

    <!-- ======================== -->
    <!-- PULSANTI                 -->
    <!-- ======================== -->
    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 5 0 0 0;">
        <Button fx:id="testButton" text="Testa Connessione"
                style="-fx-background-color: #1565C0; -fx-text-fill: white;
                       -fx-font-size: 12px; -fx-cursor: hand;
                       -fx-background-radius: 6px; -fx-padding: 8 16;" />

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="cancelButton" styleClass="btn-secondary" text="Annulla" />

        <Button fx:id="saveButton" defaultButton="true" styleClass="btn-save"
                text="Salva" textFill="WHITE" />
    </HBox>

</VBox>
