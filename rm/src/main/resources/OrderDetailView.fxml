<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="view-background"
            stylesheets="@/style.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="rm.view.OrderDetailController">

    <!-- HEADER -->
    <top>
        <VBox spacing="15" stylesheets="@style.css">
            <padding>
                <Insets bottom="10" left="20" right="20" top="20" />
            </padding>

            <!-- Link Indietro -->
            <Label fx:id="lblBack" onMouseClicked="#goBack" styleClass="text-link" text="← Financial" />

            <!-- Titolo -->
            <Label fx:id="lblTitle" style="-fx-font-size: 28px;" styleClass="text-header" text="Ordine #123" />
        </VBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;" vbarPolicy="AS_NEEDED">

            <VBox fx:id="contentBox" spacing="20" style="-fx-background-color: white;">
                <padding>
                    <Insets bottom="30" left="30" right="30" top="20" />
                </padding>

                <!-- Contenuto dinamico caricato dal controller -->
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
