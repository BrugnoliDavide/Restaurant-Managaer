<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns:fx="http://javafx.com/fxml">
    <content>
        <VBox spacing="10">
            <CheckBox fx:id="chkEnabled" text="Abilita stampa automatica comande"/>

            <Label text="Stampante:"/>
            <ComboBox fx:id="cmbPrinter" promptText="Seleziona stampante"/>

            <Label text="Larghezza (caratteri):"/>
            <Spinner fx:id="spnWidth" min="32" max="80" initialValue="48"/>

            <CheckBox fx:id="chkAutoCut" text="Taglio automatico" selected="true"/>

            <Button text="Test Stampa" onAction="#handleTestPrint"/>
        </VBox>
    </content>
</DialogPane>