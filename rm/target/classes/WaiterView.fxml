<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="root"
            styleClass="waiter-root"
            stylesheets="@/style.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="rm.view.WaiterController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="text-header" stylesheets="@style.css">
            <StackPane fx:id="profileBtn" onMouseClicked="#handleProfileMenu" styleClass="profile-circle" stylesheets="@style.css">
                <Circle fx:id="profileCircle" radius="25" styleClass="profile-circle" />
            </StackPane>

            <VBox spacing="2">
                <Label fx:id="lblHeaderName" styleClass="text-title" text="..." />
                <Label fx:id="lblHeaderRole" styleClass="text-subtitle" text="..." />
            </VBox>

            <Label fx:id="lblWelcomeTop" style="-fx-font-size: 13;" styleClass="text-subtitle" text="..." />

            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" styleClass="waiter-scroll">
                <content>
                    <VBox fx:id="notificationsContainer" alignment="TOP_CENTER" spacing="15" styleClass="waiter-notifications">
                        <padding>
                            <Insets bottom="20" left="20" right="20" top="20" />
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </StackPane>
    </center>

    <bottom>
        <VBox alignment="CENTER" prefHeight="168.0" prefWidth="179.0" spacing="10" stylesheets="@style.css">
            <padding><Insets bottom="10" top="20" /></padding>

            <Button fx:id="btnNewOrder" onAction="#handleNewOrder" styleClass="dashboard-btn" text="new&#10;order" textAlignment="CENTER" />

            <Label styleClass="waiter-table-label" text="table" />

            <TextField fx:id="txtTable" alignment="CENTER" maxWidth="700.0" promptText="number" styleClass="input-standard" />
        </VBox>
    </bottom>

</BorderPane>
