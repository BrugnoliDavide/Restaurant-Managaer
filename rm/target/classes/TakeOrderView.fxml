<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rm.view.TakeOrderController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <VBox spacing="2">
                <Label fx:id="lblSubtitle" style="-fx-font-size: 14px; -fx-text-fill: #888;" text="Waiter" />
                <Label fx:id="lblTitle" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
            </VBox>

            <TextField fx:id="searchField" promptText="Cerca prodotto...">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10" />
                </padding>
            </TextField>

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#handleCancel" prefHeight="35.0" prefWidth="67.0" style="-fx-background-color: #E02E2E; -fx-text-fill: white;" styleClass="btn-secondary" stylesheets="@style.css" text="Cancel">
            <font>
               <Font size="9.0" />
            </font></Button>

        </HBox>

    </top>


    <!-- LISTA PRODOTTI -->
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox fx:id="productsContainer" spacing="5">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>
            </VBox>
        </ScrollPane>
    </center>


    <bottom>
        <StackPane alignment="CENTER" stylesheets="@style.css">
            <padding>
                <Insets bottom="10" />
            </padding>

            <Button fx:id="btnSend" onAction="#handleSend" style="-fx-font-size: 16px; -fx-font-weight: bold;" styleClass="dashboard-btn" stylesheets="@style.css" text="Send Order" />
        </StackPane>
    </bottom>

</BorderPane>
