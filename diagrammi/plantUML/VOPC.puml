@startuml
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing true
skinparam roundcorner 15

' colori per layer
skinparam package {
  BackgroundColor<<app>> #E3F2FD
  BackgroundColor<<controller>> #E8F5E9
  BackgroundColor<<view>> #FFF3E0
  BackgroundColor<<bean>> #F3E5F5
  BackgroundColor<<model>> #E0F2F1
  BackgroundColor<<service>> #FBE9E7
}

package "app" <<app>> {
  class MainApp {
    +start(Stage)
    +main(String[])
  }

  class SceneManager {
    +init(Stage)
    +showLogin()
    +showMenu()
    +showView(String)
  }

  class UserSession {
    +getInstance(User)
    +getInstance()
    +cleanUserSession()
    +getUser()
  }

  class UsersFactory {
    +createUser(String, String)
  }

  class CliApp {
    +main(String[])
  }

  class AppStatus {
    +isDbConnectionOk()
    +setDbConnectionOk(boolean)
  }
}

package "controller" <<controller>> {
  interface DBConfigUseCase {
    +loadConfig()
    +saveConfig(...)
  }

  class DBConfigController {
    +loadConfig()
    +saveConfig(...)
  }

  class EarningService {
    +loadOrdersToPay()
    +markOrderAsPaid(int)
  }
}

package "view" <<view>> {
  interface View
  class ViewFactory {
    +getLoginView()
    +forRole(String)
  }
  class LoginController
}

package "model" <<model>> {
  class User {
    +getUsername()
    +getRole()
  }

  class ManagerUser
  class WaiterUser
  class KitchenUser

  class Order {
    +getId()
    +getTotale()
  }

  class OrderItem
  class MenuProduct
}

package "bean" <<bean>> {
  class UserBean {
    +getUsername()
    +getRole()
  }

  class ProductBean {
    +getNome()
    +getPrezzoVendita()
  }

  class OrderBean {
    +getId()
    +getTotale()
    +addItem()
  }

  class OrderItemBean {
    +getQuantita()
    +getSubtotale()
  }

  class TavoloBean {
    +isFree()
    +isOccupied()
  }
}

package "service" <<service>> {
  class ConnectionManager {
    +configure(...)
    +testConnection()
  }

  class SecurityService {
    +authenticate(...)
    +registerUser(...)
  }

  class OrderService {
    +getToPay()
    +findById(int)
  }

  interface ProductDAO {
    +delete(long)
  }

  class DatabaseProductDAO
}

' relazioni
MainApp --> ConnectionManager
MainApp --> AppStatus
MainApp --> SceneManager
MainApp --> LoginController

SceneManager --> ViewFactory
SceneManager --> View

UserSession --> User
UserSession --> SceneManager

UsersFactory --> User
UsersFactory --> ManagerUser
UsersFactory --> WaiterUser
UsersFactory --> KitchenUser

CliApp --> ConnectionManager
CliApp --> SecurityService
CliApp --> OrderService
CliApp --> ProductDAO

DBConfigController ..|> DBConfigUseCase
DBConfigController --> ConnectionManager

EarningService ..> OrderService

DatabaseProductDAO ..|> ProductDAO

OrderBean "1" o-- "*" OrderItemBean

User <|-- ManagerUser
User <|-- WaiterUser
User <|-- KitchenUser

@enduml