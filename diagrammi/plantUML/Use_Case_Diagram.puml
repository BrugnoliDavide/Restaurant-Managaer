@startuml Restaurant_Manager_Use_Case_Overview

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #333333
skinparam ActorBorderColor #333333
skinparam UsecaseBorderColor #333333
skinparam UsecaseBackgroundColor #FAFAFA
skinparam PackageBorderColor #999999
skinparam PackageBackgroundColor #F5F5F5
skinparam shadowing false

' ─────────────────────────────────────────
'  ACTORS
' ─────────────────────────────────────────

actor Manager       as MGR
actor Waiter        as WAI
actor "Kitchen Staff" as KIT
actor Cashier       as CAS

' ─────────────────────────────────────────
'  SYSTEM BOUNDARY
' ─────────────────────────────────────────

rectangle "Restaurant Manager" {

    ' ─── SHARED ───────────────────────────
    usecase "Login"                     as UC_LOGIN
    usecase "Change Password"           as UC_PWD

    ' ─── MANAGER ──────────────────────────
    usecase "Manage Menu *"             as UC_MENU
    usecase "Add Menu Item"             as UC_MENU_ADD
    usecase "Edit Menu Item"            as UC_MENU_EDIT
    usecase "Delete Menu Item"          as UC_MENU_DEL
    usecase "View Financial Report *"   as UC_FIN
    usecase "Filter Data"               as UC_FIN_FILTER
    usecase "Manage Users *"            as UC_USERS

    ' ─── WAITER ───────────────────────────
    usecase "Create an Order *"         as UC_ORDER
    usecase "Apply Item Customization"  as UC_ORDER_CUST
    usecase "Add Order Note"            as UC_ORDER_NOTE
    usecase "Remove Item from Cart"     as UC_ORDER_DEL

    ' ─── KITCHEN ──────────────────────────
    usecase "View Orders *"             as UC_KIT_VIEW
    usecase "Configure Kitchen\nPreferences" as UC_KIT_PREF
    usecase "Mark Order as Ready *"     as UC_KIT_READY

    ' ─── CASHIER ──────────────────────────
    usecase "Close an Order *"          as UC_CLOSE
    usecase "Select Table"              as UC_CLOSE_TABLE
    usecase "Read Order Data"           as UC_CLOSE_READ
    usecase "Apply Discount"            as UC_CLOSE_DISC

}

' ─────────────────────────────────────────
'  ACTOR ASSOCIATIONS
' ─────────────────────────────────────────

MGR --> UC_LOGIN
MGR --> UC_PWD
MGR --> UC_MENU
MGR --> UC_FIN
MGR --> UC_USERS

WAI --> UC_LOGIN
WAI --> UC_PWD
WAI --> UC_ORDER

KIT --> UC_LOGIN
KIT --> UC_PWD
KIT --> UC_KIT_VIEW
KIT --> UC_KIT_READY

CAS --> UC_LOGIN
CAS --> UC_PWD
CAS --> UC_CLOSE

' ─────────────────────────────────────────
'  RELATIONSHIPS
' ─────────────────────────────────────────

' Manage Menu extensions
UC_MENU       <.. UC_MENU_ADD  : <<extends>>
UC_MENU       <.. UC_MENU_EDIT : <<extends>>
UC_MENU       <.. UC_MENU_DEL  : <<extends>>

' Financial Report extension
UC_FIN        <.. UC_FIN_FILTER : <<extends>>

' Create an Order extensions
UC_ORDER      <.. UC_ORDER_CUST : <<extends>>
UC_ORDER      <.. UC_ORDER_NOTE : <<extends>>
UC_ORDER      <.. UC_ORDER_DEL  : <<extends>>

' View Orders extension
UC_KIT_VIEW   <.. UC_KIT_PREF  : <<extends>>

' Close an Order includes + extension
UC_CLOSE      ..> UC_CLOSE_TABLE : <<includes>>
UC_CLOSE      ..> UC_CLOSE_READ  : <<includes>>
UC_CLOSE      <.. UC_CLOSE_DISC  : <<extends>>

' All use cases marked * include Login
UC_MENU       ..> UC_LOGIN : <<includes>>
UC_FIN        ..> UC_LOGIN : <<includes>>
UC_USERS      ..> UC_LOGIN : <<includes>>
UC_ORDER      ..> UC_LOGIN : <<includes>>
UC_KIT_VIEW   ..> UC_LOGIN : <<includes>>
UC_KIT_READY  ..> UC_LOGIN : <<includes>>
UC_CLOSE      ..> UC_LOGIN : <<includes>>
UC_PWD        ..> UC_LOGIN : <<includes>>

' ─────────────────────────────────────────
'  NOTE
' ─────────────────────────────────────────

note bottom of UC_LOGIN
  Prerequisito obbligatorio
  per tutti i Use Cases
  contrassegnati con (*)
end note

note bottom of UC_ORDER
  Il prezzo e il costo di ogni
  OrderItem vengono acquisiti
  come snapshot al momento
  della creazione dell'ordine.
end note

@enduml