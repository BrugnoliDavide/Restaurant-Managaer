' === PACKAGE VIEW ===
package "com.example.rm.view" #FFF9C4 {
    interface View {
        +Parent getRoot()
    }
    
    abstract class AbstractView implements View {
        -Parent root
        #AbstractView(String)
    }
    
    class ViewFactory <<Factory>> {
        +{static} View forRole(String)
        +{static} View forTakeOrder(int)
        +{static} View getLoginView()
    }
    
    ' === CONTROLLERS ===
    class LoginController {
        @FXML TextField userField
        @FXML PasswordField passField
        @FXML Circle dbStatusCircle
        -void handleLogin()
        -void updateDbStatusIndicator()
    }
    
    class ManagerController {
        @FXML Label lblWelcomeTop
        -void handleProfileMenu()
        -void goToMenu()
        -void goToFinancial()
    }
    
    class WaiterController {
        @FXML VBox notificationsContainer
        @FXML TextField txtTable
        -Timeline pollingTimeline
        -WaiterNotificationCardFactory cardFactory
        -void refreshNotifications()
        -void handleNewOrder()
        +void stopPolling()
    }
    
    class KitchenController {
        @FXML VBox ordersContainer
        @FXML Label lblActiveFilters
        -KitchenOrderCardFactory cardFactory
        +void refreshData()
        -void showPreferencesDialog()
    }
    
    class TakeOrderController {
        @FXML VBox productsContainer
        @FXML Button btnSend
        -int numeroTavolo
        -Map<Integer, OrderItem> carrello
        +void init(int)
        -void handleSend()
        -void renderProducts()
    }
    
    class MenuController {
        @FXML VBox menuContainer
        @FXML TextField txtSearch
        -List<MenuProduct> allProductsMaster
        -void loadDataFromDB()
        -void renderMenu(List<MenuProduct>)
        +void onAddProduct()
    }
    
    class FinancialController {
        @FXML VBox ordersContainer
        @FXML TextField txtSearch
        -List<Order> allOrdersMaster
        -void loadDataFromDB()
        -void navigateToOrderDetail(Order)
        -void renderOrders(List<Order>)
    }
    
    class EarningController {
        @FXML VBox ordersContainer
        @FXML VBox detailsPane
        @FXML TextField searchField
        -List<Order> allOrders
        -Map<Integer, List<Order>> ordersByTable
        -Timeline pollingTimeline
        -void loadOpenOrders()
        -void markTableAsPaid(List<Order>)
        +void stopPolling()
    }
    
    class OrderDetailController {
        @FXML Label lblTitle
        @FXML VBox contentBox
        -OrderUseCase orderUseCase
