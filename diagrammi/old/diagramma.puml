' === RELATIONSHIPS ===

' App relationships
MainApp --> SceneManager : uses
SceneManager --> ViewFactory : creates views

UserSession --> User : holds
UsersFactory --> User : creates
UsersFactory ..> ManagerUser : creates
UsersFactory ..> WaiterUser : creates
UsersFactory ..> KitchenUser : creates

' Model relationships
Order "1" *-- "many" OrderItem : contains
OrderItem "many" --> "1" MenuProduct : references

' Controller relationships
MenuService --> ProductDAO : uses
MenuService --> CategoryDAO : uses
OrderService --> DatabaseService : delegates
KitchenService --> DatabaseService : delegates
EarningService --> DatabaseService : delegates
FinancialService --> DatabaseService : delegates
ManagerService --> DatabaseService : delegates
KitchenPreferencesController --> KitchenPreferencesDAO : uses

' DAO relationships
DatabaseService --> OrderDAO : manages
DatabaseProductDAO --> DatabaseService : uses
DatabaseCategoryDAO --> DatabaseService : uses
DatabaseKitchenPreferencesDAO --> DatabaseService : uses
DatabaseKitchenPreferencesDAO --> PreferencesSerializer : uses

' Service relationships
SecurityService --> DatabaseService : uses
DBConfigStore --> DatabaseService : configures

' View Factory relationships
ViewFactory ..> LoginView : creates
ViewFactory ..> ManagerView : creates
ViewFactory ..> WaiterView : creates
ViewFactory ..> KitchenView : creates
ViewFactory ..> MenuView : creates
ViewFactory ..> FinancialView : creates
ViewFactory ..> EarningView : creates
ViewFactory ..> UsersView : creates
ViewFactory ..> TakeOrderView : creates
ViewFactory ..> WaiterEinkView : creates
ViewFactory ..> KitchenEinkView : creates
ViewFactory ..> EarningEinkView : creates
ViewFactory ..> TakeOrderEinkView : creates

' Controller to UseCase relationships
LoginController --> SecurityService : authenticates
LoginController --> AppStatus : checks
WaiterController --> WaiterNotificationCardFactory : uses
WaiterController --> OrderUseCase : uses
KitchenController --> KitchenOrderCardFactory : uses
KitchenController --> KitchenUseCase : uses
TakeOrderController --> OrderUseCase : uses
TakeOrderController --> MenuUseCase : uses
MenuController --> MenuUseCase : uses
FinancialController --> FinancialUseCase : uses
EarningController --> EarningUseCase : uses
OrderDetailController --> OrderUseCase : uses
ProductDetailController --> DatabaseService : uses
UsersController --> ManagerUseCase : uses
UsersController --> SecurityService : uses

' Component Factory relationships
KitchenController --> SimpleGraphicsManager : checks mode
WaiterController --> SimpleGraphicsManager : checks mode
KitchenOrderCardFactoryClassic --> KitchenUseCase : uses
KitchenOrderCardFactoryEink --> KitchenUseCase : uses
WaiterNotificationCardFactoryClassic --> OrderUseCase : uses
WaiterNotificationCardFactoryEink --> OrderUseCase : uses

' Dialog relationships
AddProductDialog --> MenuUseCase : uses
KitchenPreferencesDialog --> KitchenPreferencesUseCase : uses
KitchenPreferencesDialog --> CategoryDAO : uses
DBConfigPopupController --> DemoModeManager : updates
DBConfigPopupController --> SimpleGraphicsManager : updates

' Preference relationships
KitchenPreferencesController --> KitchenPreferences : manages
DatabaseService --> KitchenPreferences : loads/saves

' Navigation flows
LoginController ..> UserSession : creates
LoginController ..> SceneManager : navigates
WaiterController ..> SceneManager : navigates
KitchenController ..> UserSession : reads
TakeOrderController ..> UserSession : reads

