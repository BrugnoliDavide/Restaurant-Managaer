' === PACKAGE MODEL ===
package "com.example.rm.model" #FFF3E0 {
    abstract class User {
        #String username
        #String role
        +String getUsername()
        +String getRole()
        +{abstract} String getWelcomeMessage()
    }
    
    class ManagerUser extends User {
        +String getWelcomeMessage()
    }
    
    class WaiterUser extends User {
        +String getWelcomeMessage()
    }
    
    class KitchenUser extends User {
        +String getWelcomeMessage()
    }
    
    class MenuProduct {
        -IntegerProperty id
        -StringProperty nome
        -StringProperty tipologia
        -DoubleProperty prezzoVendita
        -DoubleProperty costoRealizzazione
        -StringProperty allergeni
        +double getMargine()
        +double getPercentualeMargine()
    }
    
    class Order {
        -IntegerProperty id
        -ObjectProperty<LocalDateTime> dataOra
        -IntegerProperty tavolo
        -StringProperty username
        -StringProperty note
        -StringProperty status
        -DoubleProperty totale
        -List<String> displayItems
        +List<String> getDisplayItems()
        +boolean hasNote()
    }
    
    class OrderItem {
        -MenuProduct product
        -int quantita
        -double prezzoSnapshot
        -double costoSnapshot
        -String nomeSnapshot
        +String getDisplayName()
    }
}

' === PACKAGE CONTROLLER (USE CASES) ===
package "com.example.rm.controller" #E3F2FD {
    interface MenuUseCase {
        +List<MenuProduct> loadAllProducts()
        +List<String> loadCategories()
        +boolean addProduct(MenuProduct)
        +boolean updateProduct(MenuProduct)
        +MenuProduct getProductById(int)
    }
    
    class MenuService implements MenuUseCase {
        -ProductDAO productDAO
        -CategoryDAO categoryDAO
    }
    
    interface OrderUseCase {
        +List<Order> loadReadyOrdersForWaiter()
        +List<String> loadOrderItemsForDisplay(int)
        +boolean markOrderAsDelivered(int)
        +boolean createOrder(List<OrderItem>, Integer, String, User)
        +Order getOrderById(int)
    }
    
    class OrderService implements OrderUseCase
    
    interface KitchenUseCase {
        +KitchenPreferences loadPreferences(String)
        +List<Order> loadFilteredOrders(String)
        +void decomposeOrder(int)
        +void markOrderAsReady(int)
        +List<String> getOrderItemsDisplay(int)
    }
    
    class KitchenService implements KitchenUseCase
    
    interface EarningUseCase {
        +List<Order> loadOrdersToPay()
        +List<OrderItem> getOrderItemsDetailed(int)
        +boolean markOrderAsPaid(int)
        +boolean hasPendingOrders(int)
    }
    
    class EarningService implements EarningUseCase
    
    interface FinancialUseCase {
        +List<Order> loadAllOrdersWithTotal()
        +List<Order> loadAllOrdersWithDisplayItems()
    }
    
    class FinancialService implements FinancialUseCase
    
    interface ManagerUseCase {
        +List<User> loadAllUsers()
        +boolean deleteUser(String)
    }
    
    class ManagerService implements ManagerUseCase
    
    interface KitchenPreferencesUseCase {
        +KitchenPreferences load(String)
        +boolean save(KitchenPreferences)
        +boolean reset(String)
    }
    
    class KitchenPreferencesController implements KitchenPreferencesUseCase {
        -KitchenPreferencesDAO dao
    }
}

' === PACKAGE DAO ===
package "com.example.rm.dao" #F3E5F5 {
    interface OrderDAO {
        +boolean createOrder(List<OrderItem>, Integer, String, User)
        +List<Order> getAllOrdersWithTotal()
        +List<Order> getOrdersByStatus(String)
        +boolean setOrderStatus(int, String)
        +List<String> getOrderItemsForDisplay(int)
        +boolean decomposeOrderIfNeeded(int)
    }
    
    class OrderDAOPostgres implements OrderDAO {
        -String url
        -String user
        -String password
        -Connection getConnection()
    }
    
    class OrderDAOFile implements OrderDAO {
        -Path ordersFilePath
        -Path orderItemsDir
        -int nextOrderId
