        @FXML Button btnEdit
        @FXML Button btnDelete
        -MenuProduct product
        +void setProduct(MenuProduct)
        -void render()
    }
    
    class UsersController {
        @FXML TableView<User> usersTable
        @FXML TextField txtUser
        @FXML ComboBox<String> comboRole
        -void handleAdd()
        -void handleDelete()
    }
}

