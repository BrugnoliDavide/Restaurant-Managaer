    interface ProductDAO {
        +boolean save(MenuProduct)
        +boolean delete(Long)
    }
    
    class DatabaseProductDAO implements ProductDAO
    
    interface CategoryDAO {
        +List<String> getAllCategories()
    }
    
    class DatabaseCategoryDAO implements CategoryDAO
    
    interface KitchenPreferencesDAO {
        +KitchenPreferences loadByUsername(String)
        +boolean save(KitchenPreferences)
        +boolean deleteByUsername(String)
    }
    
    class DatabaseKitchenPreferencesDAO implements KitchenPreferencesDAO
}

