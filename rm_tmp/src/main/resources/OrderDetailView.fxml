<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="view-background"
            stylesheets="@/style.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.rm.view.OrderDetailController">

    <!-- HEADER -->
    <top>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>

            <!-- Link Indietro -->
            <Label fx:id="lblBack"
                   text="← Financial"
                   onMouseClicked="#goBack"
                   styleClass="link-label"/>

            <!-- Titolo -->
            <Label fx:id="lblTitle"
                   text="Ordine #123"
                   styleClass="text-header"
                   style="-fx-font-size: 28px;"/>
        </VBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent;">

            <VBox fx:id="contentBox"
                  spacing="20"
                  style="-fx-background-color: white;">
                <padding>
                    <Insets top="20" right="30" bottom="30" left="30"/>
                </padding>

                <!-- Contenuto dinamico caricato dal controller -->
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>